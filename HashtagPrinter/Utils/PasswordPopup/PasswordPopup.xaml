<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Utils.PasswordPopup.PasswordPopup"
               xmlns:vm="clr-namespace:Utils.PasswordPopup"
               x:DataType="vm:PasswordPopupViewModel"
               >
    <Border BackgroundColor="White" Padding="12">
        <VerticalStackLayout Spacing="10">
            <Label Text="Введите пароль" FontAttributes="Bold" TextColor="Black" />
            <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Пароль" Text="{Binding EnteredPassword}" TextColor="Black" />
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <Button Text="Отмена" Command="{Binding CancelCommand}" />
                <Button Text="ОК" Command="{Binding SaveCommand}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
