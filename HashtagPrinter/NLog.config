<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      throwExceptions="false"
      internalLogLevel="Off">

	<targets>
		<target name="logfile" xsi:type="File" fileName="${specialfolder:folder=LocalApplicationData}/Skarynagram/logs/log.log"
				encoding="utf-8" writeBom="true"
				archiveFileName="${specialfolder:folder=LocalApplicationData}/Skarynagram/logs/archive/log.{#}.log"
				archiveNumbering="Date"
				archiveEvery="Day"
				archiveDateFormat="yyyy-MM-dd"
				maxArchiveFiles="30"
				keepFileOpen="false"
				layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=ToString}" />
		<!-- <target name="logconsole" layout="${level:uppercase=true} | ${logger} | ${message} ${exception:format=ToString}" xsi:type="Console" /> -->
	</targets>

	<rules>
		<logger name="*" minlevel="Trace" writeTo="logfile,logconsole" />
	</rules>
</nlog>
